# Multi-stage Dockerfile for building the eBPF process tracer as a static binary.
#
# Uses Ubuntu 24.04 for libbpf >= 1.0 (required for BTF_KIND_ENUM64 support
# generated by kernel 6.1's pahole).
#
# Stages:
#   bpf-build       - Compile eBPF bytecode and generate skeleton header
#   userspace-build  - Compile static userspace binary
#   output           - Minimal scratch image with just the binary
#
# Usage:
#   DOCKER_BUILDKIT=1 docker build --target output --output type=local,dest=./out .

FROM ubuntu:24.04 AS bpf-build

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        llvm \
        libelf-dev \
        libbpf-dev \
        linux-tools-common \
        linux-tools-generic \
        build-essential \
        pkg-config \
        zlib1g-dev \
    && rm -rf /var/lib/apt/lists/* \
    && BPFTOOL=$(find /usr/lib /usr/sbin /usr/bin -name bpftool -type f 2>/dev/null | head -1) \
    && if [ -n "$BPFTOOL" ]; then ln -sf "$BPFTOOL" /usr/local/bin/bpftool; fi

# Copy source files
COPY vmlinux.h /build/vmlinux.h
COPY bpf/ /build/bpf/
WORKDIR /build/bpf

# Compile eBPF bytecode
RUN clang -g -O2 -target bpf \
    -D__TARGET_ARCH_x86 \
    -I/build \
    -I/usr/include \
    -c process.bpf.c -o process.bpf.o

# Generate skeleton header
RUN bpftool gen skeleton process.bpf.o > process.skel.h

# ---------------------------------------------------------------------------
# Build static userspace binary
# ---------------------------------------------------------------------------
FROM bpf-build AS userspace-build

RUN apt-get update && apt-get install -y --no-install-recommends libzstd-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cc -static -O2 \
    -I/build \
    -I/build/bpf \
    process.c \
    -lbpf -lelf -lz -lzstd \
    -o /ebpf-tracer

# ---------------------------------------------------------------------------
# Output (scratch = only the binary)
# ---------------------------------------------------------------------------
FROM scratch AS output
COPY --from=userspace-build /ebpf-tracer /ebpf-tracer
